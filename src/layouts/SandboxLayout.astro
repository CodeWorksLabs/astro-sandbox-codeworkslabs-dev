---
interface Props {
	title: string;
	description: string;
	currentPath: '/' | '/analytics/';
}

const { title, description, currentPath } = Astro.props;
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/analytics/', label: 'Analytics test' },
] as const;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<title>{title} · Astro Sandbox</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/" aria-label="Astro Sandbox home">
				<span class="brand-mark" aria-hidden="true">A</span>
				<span>Astro Sandbox</span>
			</a>
			<nav aria-label="Primary navigation">
				{links.map((link) => (
					<a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
						{link.label}
					</a>
				))}
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			<p>© 2026 CodeWorksLabs, a WebSynergetics property.</p>
			<p>Non-production Astro test environment.</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: #f4f1ff;
		background: #090715;
		font-synthesis: none;
	}

	* { box-sizing: border-box; }

	body {
		margin: 0;
		min-height: 100vh;
		background:
			radial-gradient(circle at 20% 0%, rgba(160, 78, 255, .22), transparent 34rem),
			radial-gradient(circle at 90% 16%, rgba(255, 91, 142, .14), transparent 28rem),
			#090715;
	}

	a { color: inherit; }

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: 72rem;
		margin: 0 auto;
		padding: 1.25rem 1.5rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: .7rem;
		font-weight: 760;
		text-decoration: none;
		letter-spacing: -.02em;
	}

	.brand-mark {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: .65rem;
		background: linear-gradient(135deg, #ff5d9e, #8d5cff);
		box-shadow: 0 0 2rem rgba(150, 88, 255, .35);
		font-size: .9rem;
	}

	nav { display: flex; gap: .35rem; }

	nav a {
		padding: .6rem .8rem;
		border-radius: .65rem;
		color: #c9c1df;
		text-decoration: none;
		font-size: .92rem;
	}

	nav a:hover,
	nav a[aria-current="page"] {
		color: #fff;
		background: rgba(255,255,255,.08);
	}

	main {
		max-width: 72rem;
		min-height: calc(100vh - 12rem);
		margin: 0 auto;
		padding: 4.5rem 1.5rem 5rem;
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: #ff8fbe;
		font-size: .78rem;
		font-weight: 800;
		letter-spacing: .16em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 12ch;
		margin: 0;
		font-size: clamp(3rem, 9vw, 6.5rem);
		line-height: .93;
		letter-spacing: -.065em;
	}

	.lede {
		max-width: 42rem;
		margin: 1.75rem 0 0;
		color: #bdb5d2;
		font-size: clamp(1.05rem, 2vw, 1.3rem);
		line-height: 1.65;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 4rem;
	}

	.card {
		padding: 1.35rem;
		border: 1px solid rgba(255,255,255,.11);
		border-radius: 1rem;
		background: rgba(255,255,255,.045);
		box-shadow: 0 1rem 4rem rgba(0,0,0,.14);
	}

	.card h2 { margin: 0 0 .6rem; font-size: 1.05rem; }
	.card p { margin: 0; color: #aaa1c2; line-height: 1.55; }
	.card a { text-underline-offset: .2em; }

	.pills { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 2rem; }
	.pill {
		padding: .45rem .7rem;
		border: 1px solid rgba(255,255,255,.12);
		border-radius: 99rem;
		color: #d8d1e8;
		background: rgba(255,255,255,.05);
		font-size: .8rem;
	}

	footer {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		max-width: 72rem;
		margin: 0 auto;
		padding: 1.5rem;
		border-top: 1px solid rgba(255,255,255,.08);
		color: #817993;
		font-size: .78rem;
	}

	footer p { margin: 0; }

	@media (max-width: 720px) {
		.site-header { align-items: flex-start; flex-direction: column; }
		main { padding-top: 3rem; }
		.grid { grid-template-columns: 1fr; margin-top: 3rem; }
		footer { flex-direction: column; }
	}
</style>
