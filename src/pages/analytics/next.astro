---
import SandboxLayout from '../../layouts/SandboxLayout.astro';
---

<SandboxLayout
	title="Analytics journey complete"
	description="The destination page for the Astro sandbox analytics journey."
	currentPath="/analytics/"
>
	<p class="eyebrow">Journey destination</p>
	<h1>Next stop reached.</h1>
	<p class="lede">
		This pageview follows the explicit journey event from the landing page, completing
		the observable sequence in the analytics provider.
	</p>

	<section class="receipt" aria-labelledby="receipt-heading">
		<h2 id="receipt-heading">Browser receipt</h2>
		<p id="journey-result" aria-live="polite">Checking how this page was reached…</p>
		<ul id="provider-results" aria-label="Provider event results"></ul>
	</section>

	<p class="back-link"><a href="/analytics/">← Start the journey again</a></p>
</SandboxLayout>

<script>
	import { configuredProviders } from '@codeworkslabs/astro-analytics/client';
	import { consumeJourneyReceipt, validateJourneyTrackResult } from '../../lib/journey-receipt';

	const result = document.querySelector<HTMLParagraphElement>('#journey-result');
	const providerResults = document.querySelector<HTMLUListElement>('#provider-results');
	const hasJourneyIdentity = document.referrer.length > 0;
	const providerLabel = (provider: string) => provider === 'fathom'
		? 'Fathom'
		: provider === 'google-analytics'
			? 'Google Analytics 4'
			: provider === 'plausible'
				? 'Plausible'
				: provider === 'matomo'
					? 'Matomo'
			: provider === 'umami' ? 'Umami' : provider;
	try {
		const receipt = consumeJourneyReceipt(
			sessionStorage,
			'cwl-astro-journey-result',
			window.location.href,
			document.referrer,
			Date.now(),
		);
			const validatedEntries = validateJourneyTrackResult(receipt, configuredProviders());
			const selectedLabel = providerLabel(receipt.selectedProvider);
			if (result) result.textContent = `${selectedLabel} accepted the event, so the journey advanced. This pageview is now the next stop.`;
			if (providerResults) {
				for (const [provider, outcome] of validatedEntries) {
					const item = document.createElement('li');
					item.className = outcome.ok === true ? 'accepted' : 'rejected';
					item.textContent = outcome.ok === true
						? `${providerLabel(provider)} accepted the event.`
						: `${providerLabel(provider)} did not accept the event (${typeof outcome.reason === 'string' ? outcome.reason : 'unknown reason'}).`;
					providerResults.append(item);
				}
			}
	} catch {
		if (result) result.textContent = hasJourneyIdentity
			? 'No valid successful journey receipt was available for this destination pageview.'
			: 'This page was opened directly, so there is no preceding journey-event receipt in this tab.';
	}
</script>

<style>
	.receipt {
		max-width: 46rem;
		margin-top: 3.5rem;
		padding: clamp(1.25rem, 4vw, 2rem);
		border: 1px solid rgba(255,255,255,.12);
		border-radius: 1.2rem;
		background: rgba(255,255,255,.05);
	}
	h2 { margin: 0 0 .8rem; }
	.receipt p { margin: 0; color: #aaa1c2; line-height: 1.6; }
	.receipt ul { display: grid; gap: .6rem; margin: 1.2rem 0 0; padding: 0; list-style: none; }
	.receipt li { padding: .7rem .8rem; border-radius: .65rem; font-weight: 700; }
	.accepted { color: #bdf8db; background: rgba(29, 157, 103, .16); }
	.rejected { color: #ffd0dc; background: rgba(211, 72, 111, .16); }
	.back-link { margin-top: 2rem; }
	.back-link a { text-underline-offset: .2em; }
</style>
