---
import SandboxLayout from '../layouts/SandboxLayout.astro';
---

<SandboxLayout
	title="Analytics test"
	description="An interactive browser test for the Analytics for Astro public event client."
	currentPath="/analytics/"
>
	<p class="eyebrow">Interactive qualification</p>
	<h1>Follow one real journey.</h1>
	<p class="lede">
		Arriving here supplies the landing pageview. Continuing records one explicit event,
		then the destination supplies the next pageview.
	</p>

	<section class="journey-panel" aria-labelledby="journey-heading">
		<div>
			<h2 id="journey-heading">Two observable stops</h2>
			<ol>
				<li><strong>Landing:</strong> every configured adapter records its standard pageview for this page.</li>
				<li><strong>Next stop:</strong> the link sends one journey event to all configured adapters before navigation.</li>
			</ol>
		</div>
		<label class="adapter-field" for="adapter-select">
			<span>Adapter required to continue</span>
			<select id="adapter-select" disabled>
				<option>Checking configured adapters…</option>
			</select>
		</label>
		<a class="journey-action" href="/analytics/next/" data-journey-next data-disabled aria-disabled="true">Continue to the next stop →</a>
		<output id="journey-status" aria-live="polite">Checking the Analytics for Astro event client…</output>
		<p class="boundary">The event fans out to every configured provider. The selected adapter is the success criterion for advancing; the destination preserves every adapter result. No retries, queues, or synthetic traffic.</p>
	</section>

	<p class="back-link"><a href="/">← Return to the sandbox overview</a></p>
</SandboxLayout>

<script>
	import {
		configuredProviders,
		providerStatuses,
		track,
		type ProviderName,
	} from '@codeworkslabs/astro-analytics/client';

	const next = document.querySelector<HTMLAnchorElement>('[data-journey-next]');
	const status = document.querySelector<HTMLOutputElement>('#journey-status');
	const adapterSelect = document.querySelector<HTMLSelectElement>('#adapter-select');
	const providerLabel = (provider: ProviderName) => provider === 'fathom'
		? 'Fathom'
		: provider === 'google-analytics'
			? 'Google Analytics 4'
			: provider === 'plausible'
				? 'Plausible'
				: provider === 'matomo'
					? 'Matomo'
					: provider;
	const providers = configuredProviders();
	const selectedProvider = () => adapterSelect?.value as ProviderName | undefined;
	const setJourneyEnabled = (enabled: boolean) => {
		if (!next) return;
		next.setAttribute('aria-disabled', String(!enabled));
		if (enabled) next.removeAttribute('data-disabled');
		else next.setAttribute('data-disabled', '');
	};
	const renderReadiness = () => {
		const provider = selectedProvider();
		if (!provider || !providers.includes(provider)) {
			setJourneyEnabled(false);
			if (status) status.textContent = 'No event adapters are configured. The journey cannot advance.';
			return false;
		}
		const runtimeStatus = providerStatuses()[provider];
		const label = providerLabel(provider);
		const ready = runtimeStatus === 'ready';
		setJourneyEnabled(ready);
		if (status) {
			status.textContent = ready
				? `${label} is ready for an explicit test event.`
				: runtimeStatus === 'consent-pending'
					? `${label} is waiting for consent. The journey has not started.`
					: `${label} is loading. The journey will be enabled when its event adapter is ready.`;
		}
		return ready;
	};
	if (adapterSelect) {
		adapterSelect.replaceChildren(...providers.map((provider) => {
			const option = document.createElement('option');
			option.value = provider;
			option.textContent = providerLabel(provider);
			return option;
		}));
		adapterSelect.disabled = providers.length === 0;
		adapterSelect.addEventListener('change', renderReadiness);
	}
	renderReadiness();
	const readinessPoll = window.setInterval(renderReadiness, 250);
	window.addEventListener('pagehide', () => window.clearInterval(readinessPoll), { once: true });
	next?.addEventListener('click', (event) => {
		event.preventDefault();
		const provider = selectedProvider();
		if (!provider || !providers.includes(provider)) {
			if (status) status.textContent = 'Select a configured adapter before continuing.';
			return;
		}
		if (providerStatuses()[provider] !== 'ready') {
			renderReadiness();
			return;
		}
		const response = track('cwl_astro_journey_continued', {
			action: 'continue',
			surface: 'astro-sandbox',
		});
		const selectedResult = response.providers[provider];
		const label = providerLabel(provider);
		if (selectedResult?.ok !== true) {
			const reason = selectedResult?.reason ?? response.reason ?? 'adapter-not-loaded';
			if (status) status.textContent = `${label} did not accept the event (${reason}). The journey has not advanced.`;
			return;
		}
		if (status) status.textContent = `${label} accepted the event. Continuing to the next stop…`;
		sessionStorage.setItem('cwl-astro-journey-result', JSON.stringify({
			selectedProvider: provider,
			response,
		}));
		window.location.assign(next.href);
	});
</script>

<style>
	.journey-panel {
		display: grid;
		gap: 1.4rem;
		max-width: 46rem;
		margin-top: 3.5rem;
		padding: clamp(1.25rem, 4vw, 2rem);
		border: 1px solid rgba(255,255,255,.12);
		border-radius: 1.2rem;
		background: rgba(255,255,255,.05);
	}

	h2 { margin: 0 0 .8rem; }
	p, li { color: #aaa1c2; line-height: 1.55; }
	ol { display: grid; gap: .65rem; margin: 0; padding-left: 1.25rem; }
	strong { color: #f4f1ff; }
	.adapter-field { display: grid; gap: .55rem; color: #f4f1ff; font-weight: 700; }
	.adapter-field span { font-size: .9rem; }
	select {
		width: min(100%, 24rem);
		padding: .72rem .8rem;
		border: 1px solid rgba(255,255,255,.2);
		border-radius: .7rem;
		color: #f4f1ff;
		background: #100d1c;
		font: inherit;
	}
	select:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
	.journey-action {
		justify-self: start;
		padding: .8rem 1rem;
		border-radius: .75rem;
		color: #120b20;
		background: linear-gradient(135deg, #ff72ad, #a887ff);
		font-weight: 750;
		text-decoration: none;
	}
	.journey-action:hover { filter: brightness(1.1); }
	.journey-action[data-disabled] { opacity: .5; pointer-events: none; }
	.journey-action:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
	output {
		display: block;
		padding: .85rem 1rem;
		border-radius: .7rem;
		color: #d9d2e9;
		background: #100d1c;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: .84rem;
		line-height: 1.5;
	}
	.boundary { margin: 0; font-size: .86rem; }
	.back-link { margin-top: 2rem; }
	.back-link a { text-underline-offset: .2em; }
</style>
